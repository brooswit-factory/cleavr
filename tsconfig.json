{
  "compilerOptions": {
    "target": "ES2020",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2020", "DOM"],
    "strict": true,
    "resolveJsonModule": true,
    "noUncheckedIndexedAccess": true,
    "types": ["chrome"],
    "skipLibCheck": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "noEmit": true
  },
  "include": ["src", "tests", "build.mjs", "scripts/extension-id.d.mts", "scripts/release.d.mts"]
}
